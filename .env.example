# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=store_intel
POSTGRES_USER=store
POSTGRES_PASSWORD=store_pass

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM=store:events
REDIS_GROUP=store-consumers
REDIS_CONSUMER=consumer-1

# ---- Pipeline ----
YOLO_MODEL=yolov8n.pt
DETECT_CONF=0.35
TARGET_FPS=10              # process every Nth frame to hit ~this fps
PERSON_CLASS_ID=0         # COCO 'person'

# ---- Store config ----
STORE_OPEN_HOUR=9
STORE_CLOSE_HOUR=21

# ---- Anomaly thresholds ----
CROWD_ZSCORE=2.5
CROWD_MIN_COUNT=5
DWELL_ALERT_SECONDS=120
ANOMALY_WINDOW=60         # seconds of rolling history

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
